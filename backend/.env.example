# PostgreSQL connection string (e.g. Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobs
PORT=3001
# Allowed browser origin(s), comma-separated
FRONTEND_URL=http://localhost:3000
# Optional: disable | no-verify (default: verified TLS, off for localhost)
DB_SSL=
# Optional: set to false to stop TypeORM from auto-syncing the schema
DB_SYNCHRONIZE=true
# Bind address. Defaults to 127.0.0.1 locally, 0.0.0.0 on a managed platform.
HOST=

# REQUIRED to enable writes. POST/PATCH/DELETE /jobs then need the
# x-admin-key header set to this value. Generate one with: openssl rand -hex 24
# Without it (and without ALLOW_PUBLIC_WRITES below) every write returns 503.
ADMIN_API_KEY=

# Set to exactly "true" only if you deliberately want an unauthenticated,
# publicly writable instance — anyone who finds the URL can create, edit and
# delete jobs. Leave empty otherwise.
ALLOW_PUBLIC_WRITES=
